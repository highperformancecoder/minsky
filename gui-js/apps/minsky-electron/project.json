{
  "name": "minsky-electron",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/minsky-electron/src",
  "projectType": "application",
  "prefix": "minsky-electron",
  "generators": {},
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "development",
      "options": {
        "platform": "node",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "thirdParty": false,
        "outputPath": "dist/apps/minsky-electron",
        "main": "apps/minsky-electron/src/main.ts",
        "tsConfig": "apps/minsky-electron/tsconfig.app.json",
        "assets": [
          {
            "input": "apps/minsky-electron/src/assets",
            "glob": "**/*",
            "output": "assets"
          }
        ],
        "external": [
          "electron"
        ],
        "sourcemap": true,
        "generatePackageJson": true,
        "esbuildOptions": {
          "outExtension": {
            ".js": ".js"
          }
        },
        "outputFileName": "main.js",
        "deleteOutputPath": false
      },
      "configurations": {
        "development": {},
        "production": {
          "minify": false,
          "sourcemap": false
        }
      },
      "dependsOn": [
        "build-preload"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "electron dist/apps/minsky-electron/main.js"
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/minsky-electron/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "jest --passWithNoTests --forceExit",
        "cwd": "{projectRoot}"
      }
    },
    "compodoc": {
      "executor": "@twittwer/compodoc:compodoc",
      "options": {
        "tsConfig": "apps/minsky-electron/tsconfig.compodoc.json",
        "outputPath": "dist/compodoc/minsky-electron",
        "workspaceDocs": true
      },
      "configurations": {
        "json": {
          "exportFormat": "json"
        }
      }
    },
    "build-preload": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "platform": "node",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "thirdParty": false,
        "outputPath": "dist/apps/minsky-electron",
        "main": "apps/minsky-electron/src/app/api/preload.ts",
        "tsConfig": "apps/minsky-electron/tsconfig.app.json",
        "external": [
          "electron"
        ],
        "sourcemap": true,
        "generatePackageJson": true,
        "esbuildOptions": {
          "outExtension": {
            ".js": ".js"
          }
        },
        "outputFileName": "preload.js",
        "deleteOutputPath": false
      },
      "configurations": {
        "development": {},
        "production": {
          "minify": false,
          "sourcemap": false
        }
      },
      "dependsOn": []
    }
  }
}
